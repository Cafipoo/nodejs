<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>🍸 Club Chat - {{ pseudo }}</title>
  <link rel="stylesheet" href="/style.css">
  <script src="/socket.io/socket.io.js"></script>
  <script defer src="/main.js"></script>
</head>
<body>
  <div id="login-container"{% if pseudo %} style="display:none;"{% endif %}>
    <h2>Connexion</h2>
    <form id="loginForm">
      <input type="text" id="login-pseudo" name="pseudo" placeholder="Votre pseudo" required autocomplete="username" />
      <input type="password" id="login-password" name="password" placeholder="Mot de passe" required autocomplete="current-password" />
      <button type="submit" id="login-submit">Se connecter</button>
    </form>
    <p>Pas de compte ? <a href="/register">Créer un compte</a></p>
  </div>

  <div id="chat-container"{% if not pseudo %} style="display:none;"{% endif %}>
    <h2>🍸 Club Chat - Bienvenue {{ pseudo }}! 🎵</h2>
    
    <ul id="messages">
       {% for message in messages %}
          <li class="message">
             <span class="pseudo">{{ message.pseudo }}:</span> {{ message.content }}
          </li>
       {% endfor %}
    </ul>
    
    <form id="messageForm">
       <input type="text" id="messageInput" placeholder="💬 Parlez dans le club..." required autocomplete="off">
       <button type="submit">🚀 Envoyer</button>
    </form>
    
    <a href="/logout" class="quit-link">🚪 Quitter le club</a>
  </div>
</body>
</html>
